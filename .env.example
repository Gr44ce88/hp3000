# Базовый URL API. Пустое значение = относительные запросы через dev-прокси Vite.
VITE_API_URL=

# Куда dev-сервер проксирует /api
VITE_PROXY_TARGET=http://localhost:8080

# Фича-флаги

# Локальный Postgres (данные вне репозитория: D:\hermes\pgdata, порт 5433)
# Поднять/погасить: npm run db:start / npm run db:stop
DATABASE_URL=postgres://postgres@127.0.0.1:5433/hookers
PGPORT=5433
PGDATA=D:/hermes/pgdata

# API
PORT=8080
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ключ Yandex Maps JS API (пусто = карта без ключа, с ограничениями)
VITE_YANDEX_MAPS_KEY=

# FreeKassa (пусто = оплата не открывается, анкета остаётся неопубликованной)
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_1=
FREEKASSA_SECRET_2=
FREEKASSA_CURRENCY=RUB
# в проде включить: белый список IP FreeKassa
FREEKASSA_CHECK_IP=false
PUBLICATION_FEE=490
